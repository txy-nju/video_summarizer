# ==============================
# Backend app settings (backend/config.py)
# ==============================
APP_NAME=video-summarizer-backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Pydantic List[str]，建议使用 JSON 数组字符串
CORS_ORIGINS=["*"]

# ==============================
# Auth / JWT (backend/config.py)
# ==============================
JWT_SECRET_KEY=change-me-access
JWT_REFRESH_SECRET_KEY=change-me-refresh
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080

# ==============================
# Database & queue (backend/config.py)
# ==============================
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/video_summarizer_test
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==============================
# Object storage (backend/config.py)
# ==============================
STORAGE_BACKEND=local
OSS_LOCAL_ROOT=temp/object_storage
OSS_PRESIGN_TTL_SECONDS=3600

# ==============================
# LLM Provider 多能力路由（按 chat / vision / transcribe 拆分）
# ==============================
# 每种能力可独立指定 provider：
#   CHAT_PROVIDER       → 纯文本对话（openai / aigc / deepseek / qwen / gemini / local）
#   VISION_PROVIDER     → 多模态视觉理解（openai / aigc / qwen / gemini / local）
#   TRANSCRIBE_PROVIDER → 语音转文本（openai / qwen / local）
#
# 不设置时默认均为 openai。
# 注意：deepseek、gemini、aigc 不支持 TRANSCRIBE_PROVIDER，需设为 openai。
CHAT_PROVIDER=openai
VISION_PROVIDER=openai
TRANSCRIBE_PROVIDER=openai

# ---------- 通用 API Key（所有 provider 共享 fallback）----------
# 推荐按 capability 分开设置；若只用单一 provider，可设此通用项。
OPENAI_API_KEY=

# ---------- 按 capability 拆分的 API Key ----------
# chat 能力用 key，按优先级 fallback：
#   CHAT_API_KEY > AIGC_API_KEY > GEMINI_API_KEY > QWEN_API_KEY
#   > DEEPSEEK_API_KEY > LOCAL_API_KEY > OPENAI_API_KEY
CHAT_API_KEY=
# vision 能力用 key，优先级同上，额外包含 VISION_API_KEY（最高优先）
VISION_API_KEY=
# transcribe 能力用 key，仅支持 openai / qwen / local 的 key
TRANSCRIBE_API_KEY=

# ---------- 各 provider 专属 API Key ----------
# 如果 chat/vision/transcribe 共用同一 provider，直接用上面 CHAT_API_KEY 即可，
# 以下为多 provider 混用场景提供独立配置。
AIGC_API_KEY=              # vivo 蓝心大模型 AppKey
GEMINI_API_KEY=            # Google AI Studio API Key
QWEN_API_KEY=              # 阿里云 DashScope API Key
DEEPSEEK_API_KEY=          # DeepSeek API Key
LOCAL_API_KEY=             # 本地推理服务 Key（通常可留空，自动用 "local" 占位）

# ---------- 按 capability 拆分的 Base URL ----------
# 优先级与 API Key 一致。不设置则使用各 provider 内置默认值。
CHAT_BASE_URL=
VISION_BASE_URL=
TRANSCRIBE_BASE_URL=

# ---------- 各 provider 专属 Base URL（仅覆盖默认值时设置）----------
AIGC_BASE_URL=             # 默认 https://api-ai.vivo.com.cn/v1
GEMINI_BASE_URL=           # 默认 https://generativelanguage.googleapis.com/v1beta/openai/
QWEN_BASE_URL=             # 默认 https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=         # 默认 https://api.deepseek.com
LOCAL_BASE_URL=            # 默认 http://localhost:11434/v1
OPENAI_BASE_URL=           # 默认 https://api.openai.com/v1

# ---------- 按 capability 拆分的 Model Name ----------
# chat 能力用模型名，按优先级 fallback：
#   CHAT_MODEL_NAME > OPENAI_MODEL_NAME > 默认 gpt-4o
CHAT_MODEL_NAME=
# vision 能力用模型名，按优先级 fallback：
#   VISION_MODEL_NAME > OPENAI_VISION_MODEL_NAME > CHAT_MODEL_NAME > OPENAI_MODEL_NAME > 默认 gpt-4o
VISION_MODEL_NAME=
# transcribe 能力用模型名，按优先级 fallback：
#   TRANSCRIBE_MODEL_NAME > TRANSCRIBER_MODEL > 默认 whisper-1
TRANSCRIBE_MODEL_NAME=

# ---------- 兼容旧版配置（仍然有效，但推荐使用上面的拆分配置）----------
OPENAI_MODEL_NAME=gpt-4o
OPENAI_VISION_MODEL_NAME=gpt-4o
TRANSCRIBER_MODEL=whisper-1

# ---------- 各 provider 推荐模型 ----------
# OpenAI:
#   chat: gpt-4o / gpt-4o-mini
#   vision: gpt-4o
#   transcribe: whisper-1
#
# vivo AIGC（provider=aigc）:
#   chat: Volc-DeepSeek-V3.2（纯文本）
#   vision: Doubao-Seed-2.0-pro / Doubao-Seed-2.0-mini / Doubao-Seed-2.0-lite / qwen3.5-plus
#
# DeepSeek（provider=deepseek）:
#   chat: deepseek-chat
#   vision: 不支持（需改用其他 provider）
#
# Qwen（provider=qwen）:
#   chat: qwen-plus / qwen-max
#   vision: qwen-vl-plus / qwen-vl-max
#
# Gemini（provider=gemini）:
#   chat: gemini-2.0-flash
#   vision: gemini-2.0-flash（同一模型支持多模态）
#
# Local（provider=local）:
#   取决于本地部署的模型，如 llama3.2、qwen2.5 等

# ---------- 推荐配置示例 ----------
# 示例 1: 全部用 OpenAI（默认，无需额外配置）
#   CHAT_PROVIDER=openai
#   OPENAI_API_KEY=sk-xxx
#
# 示例 2: chat + vision 用 vivo AIGC
#   CHAT_PROVIDER=aigc
#   VISION_PROVIDER=aigc
#   AIGC_API_KEY=sk-xuanji-xxx          # vivo 平台 AppKey
#   CHAT_MODEL_NAME=Volc-DeepSeek-V3.2
#   VISION_MODEL_NAME=Doubao-Seed-2.0-pro
#
# 示例 3: 混用 — chat 用 DeepSeek, vision 用 OpenAI
#   CHAT_PROVIDER=deepseek
#   CHAT_API_KEY=sk-xxx
#   CHAT_MODEL_NAME=deepseek-chat
#   VISION_PROVIDER=openai
#   VISION_API_KEY=sk-yyy
#   VISION_MODEL_NAME=gpt-4o

TAVILY_API_KEY=

# ==============================
# Firebase push (backend/notifications/fcm_service.py)
# ==============================
FCM_CREDENTIALS_PATH=

# ==============================
# Project root override (config/settings.py)
# ==============================
VIDEO_SUMMARY_ROOT=

# ==============================
# Checkpoint configuration
# ==============================
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_URL=

# ==============================
# Chunk planning and dispatch
# ==============================
MAP_CHUNK_SECONDS=480
MAP_CHUNK_OVERLAP_SECONDS=10
MAP_MAX_PARALLELISM=4
WAVE_DISPATCH_SIZE=4

# ==============================
# Scene-anchored chunk split
# ==============================
ENABLE_SCENE_ANCHORED_CHUNK_SPLIT=true
CHUNK_SPLIT_ANCHOR_SEARCH_SECONDS=60
CHUNK_SPLIT_DURATION_SHORT_SECONDS=600
CHUNK_SPLIT_DURATION_MEDIUM_SECONDS=1800
CHUNK_SPLIT_MIN_DURATION_SHORT_SECONDS=90
CHUNK_SPLIT_MIN_DURATION_MEDIUM_SECONDS=300
CHUNK_SPLIT_MIN_DURATION_LONG_SECONDS=480
SCENE_CHANGE_SEVERE_SHORT_THRESHOLD=0.45
SCENE_CHANGE_SEVERE_MEDIUM_THRESHOLD=0.35
SCENE_CHANGE_SEVERE_LONG_THRESHOLD=0.25

# ==============================
# Worker timeout/retry/degraded
# ==============================
CHUNK_WORKER_TIMEOUT_SECONDS=45
CHUNK_WORKER_MAX_RETRIES=1
CHUNK_DEGRADED_MARKER=<missing_context>

# ==============================
# Context memory window
# ==============================
CONTEXT_MEMORY_WINDOW_SIZE=2
CONTEXT_MEMORY_SUMMARY_MAX_CHARS=160

# ==============================
# Map-reduce behavior
# ==============================
CHUNK_MAX_TOOL_CALLS=2
ENABLE_CHUNK_CACHE=true
AGGREGATED_CHUNK_INSIGHTS_MAX_CHARS=100000

# ==============================
# Outline bootstrap
# ==============================
OUTLINE_STOPWORDS_DIR=
OUTLINE_ENTITY_LIMIT_BASE=12
OUTLINE_ENTITY_LIMIT_MAX=36
OUTLINE_ENTITY_LIMIT_STEP=4
OUTLINE_ENTITY_LIMIT_EVERY_SECONDS=1800
OUTLINE_JIEBA_TOPK=12
OUTLINE_MIN_TOKEN_LENGTH=2
OUTLINE_MAX_TOKEN_LENGTH=12
OUTLINE_ZH_REGEX_MIN=2
OUTLINE_ZH_REGEX_MAX=12
# CSV，例如: 产业,金融,医疗
OUTLINE_DOMAIN_SUFFIX_MARKERS=

# ==============================
# Metrics
# ==============================
ENABLE_METRICS_LOGGING=true
METRICS_SAMPLE_RATE=1.0

# ==============================
# Keyframe file reference
# ==============================
ENABLE_KEYFRAME_FILE_REFERENCE=false
KEYFRAME_REFERENCE_INCLUDE_INLINE_IMAGE=false
KEYFRAME_IMAGE_EXTENSION=jpg

# ==============================
# Self-RAG quality loop
# ==============================
SELF_RAG_MAX_REVISIONS=2

# ==============================
# Test-only flags
# ==============================
RUN_E2E=false
# 测试临时库管理（tests/conftest.py）
PYTEST_ADMIN_DATABASE=postgres
