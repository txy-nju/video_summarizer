# ==============================
# Docker Environment Settings
# ==============================
APP_NAME=video-summarizer-backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ==============================
# Auth / JWT
# ==============================
JWT_SECRET_KEY=change-me-access
JWT_REFRESH_SECRET_KEY=change-me-refresh
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080

# ==============================
# Database & queue (Pointed to Docker containers)
# ==============================
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/video_summarizer
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2

# ==============================
# Object storage
# ==============================
STORAGE_BACKEND=local
OSS_LOCAL_ROOT=temp/object_storage
OSS_PRESIGN_TTL_SECONDS=3600

# ==============================
# LLM provider settings
# ==============================
CHAT_PROVIDER=gemini
VISION_PROVIDER=gemini
TRANSCRIBE_PROVIDER=openai

# Capability-specific model config
CHAT_MODEL_NAME=gemini-3.5-flash
VISION_MODEL_NAME=gemini-3.5-flash
TRANSCRIBE_MODEL_NAME=whisper-1

# Capability-specific connection config
CHAT_API_KEY=AIzaSyDjFt2odJhYnok3LnB2s3FNeTQeYTEuKVQ
VISION_API_KEY=AIzaSyDjFt2odJhYnok3LnB2s3FNeTQeYTEuKVQ
TRANSCRIBE_API_KEY=sk-to6r6lBj5s0Snbf1AVfBxojl0rFzC3VCkJkjCRzJZ4VA27Ac

# ==============================
# RAG 及 Embeddings 设置
# ==============================
OPENAI_MODEL_NAME=gpt-4o
RAG_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-to6r6lBj5s0Snbf1AVfBxojl0rFzC3VCkJkjCRzJZ4VA27Ac
OPENAI_BASE_URL=https://api.openai-proxy.org/v1

TAVILY_API_KEY=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


# ==============================
# Checkpoint configuration
# ==============================
# 如果希望数据库持久化而不是内存，可以将其改为 postgres 并指向数据库
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_URL=${DATABASE_URL}

# ==============================
# Workflow and Chunk planning settings
# ==============================
MAP_CHUNK_SECONDS=300
MAP_CHUNK_OVERLAP_SECONDS=10
MAP_MAX_PARALLELISM=2
WAVE_DISPATCH_SIZE=4

CHUNK_WORKER_TIMEOUT_SECONDS=45
CHUNK_WORKER_MAX_RETRIES=1

CONTEXT_MEMORY_WINDOW_SIZE=2
CONTEXT_MEMORY_SUMMARY_MAX_CHARS=160
AGGREGATED_CHUNK_INSIGHTS_MAX_CHARS=24000
SELF_RAG_MAX_REVISIONS=2

# ==============================
# 可观测性 (OTEL / Jaeger)
# ==============================
OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_SERVICE_NAME=video-summarizer-backend
OTEL_SAMPLE_RATIO=1.0
# 使用 host.docker.internal 让容器能访问到宿主机上通过 PS 脚本启动的 Jaeger
OTEL_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_JAEGER_ENDPOINT=http://host.docker.internal:4317
